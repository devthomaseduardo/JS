{
  "version": "0.2.0",

  "configurations": [
    
    {
      "type": "node",
      "request": "launch",
      "name": "Executar arquivo atual",

      "program": "${file}",

      "cwd": "${fileDirname}",

      "console": "integratedTerminal",

      "internalConsoleOptions": "neverOpen",

      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],

      "smartStep": true,

      "autoAttachChildProcesses": true,

      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
